# AI Video Studio 环境配置模板
# 复制为 server/.env 后按需修改；未配置的项使用默认值。
# 也可通过 PUT /api/providers 在线写入（保留本文件其他行，保存后即时生效，无需重启）。

# ---------- 基础 ----------
# 运行期数据目录（SQLite + 产物 + 缓存），默认 server/data
# AVS_DATA_DIR=
# 模型权重目录，默认 server/models
# AVS_MODELS_DIR=
# mock 模式：强制生成占位产物（未安装推理依赖时自动开启），1/true 开启
# AVS_MOCK=
# ffmpeg 可执行文件，默认取 PATH 中的 ffmpeg
# AVS_FFMPEG=
# 缓存上限（GB），0 表示不限制
# AVS_CACHE_LIMIT_GB=20
# 队列空闲多久后卸载驻留模型（秒）
# AVS_MODEL_IDLE_UNLOAD=600
# 模型下载源端点（HuggingFace 镜像，国内直连默认 hf-mirror.com，可改官方）
# AVS_HF_ENDPOINT=https://hf-mirror.com

# ---------- 第三方模型服务 ----------
# 本地优先：默认 local（本地推理），未配置或调用失败时回退本地 -> mock。
# 每类任务独立配置，provider 取值：
#   local   本地推理（默认）
#   openai  OpenAI 兼容 API（llama.cpp/vLLM/硅基流动/DeepSeek 官方等）
#   ark     火山方舟（Seedream 文生图 / Seedance 视频生成，base_url 填
#           https://ark.cn-beijing.volces.com/api/v3；本地图自动转 base64 上送）
#   custom  自定义视频端点（POST /videos 提交 + task_id 轮询）

# LLM（剧本拆解 / Agent 编排）
# AVS_LLM_PROVIDER=openai
# AVS_LLM_BASE_URL=https://api.deepseek.com/v1
# AVS_LLM_API_KEY=
# AVS_LLM_MODEL=deepseek-chat
# LLM 请求超时（秒），默认 120
# AVS_LLM_TIMEOUT=120
# 旧配置（向后兼容）：设置了 AVS_LLM_ENDPOINT 且未设置 AVS_LLM_BASE_URL 时，
# 自动去掉 /chat/completions 后缀作为 base_url，等价于 AVS_LLM_PROVIDER=openai
# AVS_LLM_ENDPOINT=

# 文生图（openai 兼容 /v1/images/generations，或 ark 火山方舟 Seedream）
# AVS_T2I_PROVIDER=openai
# AVS_T2I_BASE_URL=https://api.siliconflow.cn/v1
# AVS_T2I_API_KEY=
# AVS_T2I_MODEL=Qwen/Qwen-Image
# 火山方舟示例：
# AVS_T2I_PROVIDER=ark
# AVS_T2I_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AVS_T2I_API_KEY=
# AVS_T2I_MODEL=doubao-seedream-4-0-250828

# 文生视频（ark 火山方舟 Seedance，或 custom 自定义端点：POST /videos + task_id 轮询）
# AVS_T2V_PROVIDER=ark
# AVS_T2V_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AVS_T2V_API_KEY=
# AVS_T2V_MODEL=doubao-seedance-1-0-pro-250528
# AVS_T2V_PROVIDER=custom
# AVS_T2V_BASE_URL=
# AVS_T2V_API_KEY=
# AVS_T2V_MODEL=

# 图生视频
# AVS_I2V_PROVIDER=custom
# AVS_I2V_BASE_URL=
# AVS_I2V_API_KEY=
# AVS_I2V_MODEL=

# 配音（TTS）
# AVS_TTS_PROVIDER=openai
# AVS_TTS_BASE_URL=
# AVS_TTS_API_KEY=
# AVS_TTS_MODEL=
